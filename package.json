{
  "name": "dsh-ustc-quota",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Live 3h/12h/24h USTC token quota card in the DSH sidebar (works with the USTC TokenWorks distribution).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Awenforever/dsh-ustc-quota.git"
  },
  "bugs": {
    "url": "https://github.com/Awenforever/dsh-ustc-quota/issues"
  },
  "homepage": "https://github.com/Awenforever/dsh-ustc-quota#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ustc",
    "tokenworks",
    "quota"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "quota.js",
    "update.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}

